diff --git a/target/linux/qualcommax/patches-6.12/0821-remoteproc-qcom-wcss-populate-driver-data-for-IPQ5018.patch b/target/linux/qualcommax/patches-6.12/0821-remoteproc-qcom-wcss-populate-driver-data-for-IPQ5018.patch
new file mode 100644
index 0000000..4dcee2c
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0821-remoteproc-qcom-wcss-populate-driver-data-for-IPQ5018.patch
@@ -0,0 +1,28 @@
+--- a/drivers/remoteproc/qcom_q6v5_wcss.c
++++ b/drivers/remoteproc/qcom_q6v5_wcss.c
+@@ -1218,10 +1218,25 @@ static const struct wcss_data wcss_qcs40
+ 	.need_auto_boot = true,
+ };
+ 
++static const struct wcss_data wcss_ipq5018_res_init = {
++	.init_clock = ipq_init_clock,
++	.q6_firmware_name = "IPQ5018/q6_fw.mdt",
++	.m3_firmware_name = "IPQ5018/m3_fw.mdt",
++	.crash_reason_smem = WCSS_CRASH_REASON,
++	.aon_reset_required = true,
++	.wcss_q6_reset_required = true,
++	.bcr_reset_required = false,
++	.ssr_name = "wcnss",
++	.ops = &q6v5_wcss_ipq8074_ops,
++	.requires_force_stop = true,
++	.need_mem_protection = true,
++};
++
+ static const struct of_device_id q6v5_wcss_of_match[] = {
+ 	{ .compatible = "qcom,ipq8074-wcss-pil", .data = &wcss_ipq8074_res_init },
+ 	{ .compatible = "qcom,ipq6018-wcss-pil", .data = &wcss_ipq6018_res_init },
++	{ .compatible = "qcom,ipq5018-wcss-pil", .data = &wcss_ipq5018_res_init },
+ 	{ .compatible = "qcom,qcs404-wcss-pil", .data = &wcss_qcs404_res_init },
+ 	{ },
+ };
+ MODULE_DEVICE_TABLE(of, q6v5_wcss_of_match);
